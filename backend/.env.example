# ── Server ────────────────────────────────────────────────
PORT=3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/padosipro

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@padosipro.local

# ── OTP Settings ─────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
